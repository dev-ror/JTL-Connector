# ── SQL Server (JTL Docker) ──────────────────────────────────────
SQLSERVER_HOST=localhost          # or 127.0.0.1 / Docker container IP
SQLSERVER_PORT=1433
SQLSERVER_DB=eazybusiness          # default JTL database name
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrongPassword!

# ── Odoo (Hetzner / cloudpepper) ────────────────────────────────
ODOO_HOST=https://your-odoo.example.com   # no trailing slash
ODOO_PORT=443                              # 8069 for plain HTTP
ODOO_DB=your_odoo_database
ODOO_USER=admin
ODOO_API_KEY=your_odoo_api_key             # preferred over password
# ODOO_PASSWORD=admin                      # fallback if no API key
